# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# tauri rust build artifacts
/src-tauri/target/

# data - exclude all runtime data (user records, sessions, snapshots, backups)
.data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# tauri default icon (replaced by public/orig_icon.png)
app-icon.png

# minisign keys (hot-update signing) — never commit private keys
*.key
*.key.b64
hot-update.key
hot-update.pub
minisign.key
minisign.pub

# test scratch files
.fttest/

# 测试/调试脚本目录（测试脚本统一放 scripts/tests/，不进 git；构建脚本 scripts/*.mjs 仍需跟踪）
/scripts/tests/

# notes
TO DO.txt

# typescript
*.tsbuildinfo
next-env.d.ts
