# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# tauri rust build artifacts
/src-tauri/target/

# data - exclude all runtime data (user records, sessions, snapshots, backups)
.data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# tauri default icon (replaced by public/orig_icon.png)
app-icon.png

# minisign keys (hot-update signing) — never commit private keys
*.key
*.key.b64
hot-update.key
hot-update.pub
minisign.key
minisign.pub

# local toolchains & build artifacts (portable Go, music-service binaries)
.tools/
/music-service/music-service
/music-service/music-service.exe
/music-service/bin/

# 点歌解析服务：Go 依赖缓存/构建缓存
/music-service/.cache/

# 临时调试日志
*.log
debug.log

# Trae 本地过程文档（AI 生成，不随仓库分发）
.trae/documents/

# 抓取/反编译得到的研究产物（仅供本地参考，不入库）
_js_research/
_probe_js/

# test scratch files
.fttest/

# 测试/调试脚本目录（测试脚本统一放 scripts/tests/，不进 git；构建脚本 scripts/*.mjs 仍需跟踪）
/scripts/tests/
/scripts/output/

# notes
TO DO.txt
TRAE dialog/

# typescript
*.tsbuildinfo
next-env.d.ts


deploy/nginx.conf.example
scripts/gift-effect-merge.mjs

