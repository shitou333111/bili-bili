{
  "identifier": "default",
  "windows": ["main", "activity", "activity-panel", "real-activity", "real-activity-panel"],
  "remote": {
    "urls": ["http://*:*", "https://*:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-fetch-json",
    "allow-debug-acl",
    "allow-open-activity-panel",
    "allow-close-activity-panel",
    "allow-open-real-activity-panel",
    "allow-close-real-activity-panel",
    "allow-check-native-update",
    "allow-download-and-open-ipa",
    "allow-download-apk",
    "allow-download-ipa",
    "allow-restart-app",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    },
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "store:default",
    "opener:default",
    "pldownloader:default",
    "sharekit:default",
    "hotswap:default",
    "android-installer:default"
  ]
}