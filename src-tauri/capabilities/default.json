{
  "identifier": "default",
  "windows": ["main", "activity", "activity-panel", "real-activity", "real-activity-panel"],
  "remote": {
    "urls": ["http://*:*", "https://*:*"]
  },
  "permissions": [
    "core:default",
    "core:event:allow-emit-to",
    "core:window:allow-set-always-on-top",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "allow-fetch-json",
    "allow-debug-acl",
    "allow-open-activity-panel",
    "allow-close-activity-panel",
    "allow-open-real-activity-panel",
    "allow-close-real-activity-panel",
    "allow-start-display-server",
    "allow-stop-display-server",
    "allow-broadcast-display",
    "allow-pick-video-file",
    "allow-check-native-update",
    "allow-download-apk",
    "allow-download-ipa",
    "allow-download-exe",
    "allow-apply-in-place-update",
    "allow-restart-app",
    "allow-start-wsa-recording",
    "allow-stop-wsa-recording",
    "allow-wsa-recording-status",
    "allow-start-raw-record",
    "allow-stop-raw-record",
    "allow-wsa-setup-status",
    "allow-wsa-setup-install",
    "allow-wsa-setup-abort",
    "allow-output-dir",
    "allow-open-output-folder",
    "allow-commit-output-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    },
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "store:default",
    "opener:default",
    "pldownloader:default",
    "sharekit:default",
    "hotswap:default",
    "android-installer:default",
    "autostart:default"
  ]
}