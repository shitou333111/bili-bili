{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "B瓜",
  "version": "0.0.2",
  "identifier": "com.bili-live.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "B瓜",
        "width": 1000,
        "height": 1778,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "hotswap": {
      "endpoint": "https://bili-bili.icu/artifacts/webapp/hotswap.json",
      "pubkey": "RWT4TcdT0ohMSmvTKHCFHRkIL4yWy5B+8/xmuTOcJAogwLmTm+AuWKW3",
      "require_https": true,
      "binary_cache_policy": "keep_compatible",
      "confirmation_policy": "single_launch",
      "rollback_policy": "latest_confirmed",
      "max_retained_versions": 2
    }
  }
}